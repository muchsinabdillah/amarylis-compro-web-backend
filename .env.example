# =====================================================================
# Website Company Profile — Klinik Pratama Andini
# =====================================================================
# Salin menjadi .env lalu isi. Berkas .env TIDAK boleh masuk ke git.

APP_NAME="Klinik Pratama Andini"
APP_ENV=local                 # local | production
APP_DEBUG=true                # WAJIB false di production
# Alamat situs publik (dipakai sitemap.xml dan robots.txt).
SITE_URL=http://localhost:5173
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# Alamat frontend, dipakai daftar putih CORS. Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Basis data — MILIK WEBSITE SENDIRI
# ---------------------------------------------------------------------
# Website memakai database terpisah dari SIMRS. Tidak ada satu pun kredensial
# SIMRS di berkas ini: data SIMRS diambil lewat API (lihat blok di bawah).
#
# Pemisahan ini yang membuat website bisa dipindah ke server lain, dicadangkan,
# dan dipulihkan tanpa menyentuh SIMRS sama sekali.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=webcompro
DB_USER=webcompro_app
DB_PASS=
DB_SCHEMA=webcompro

# ---------------------------------------------------------------------
# Integrasi SIMRS (satu-satunya tautan ke SIMRS)
# ---------------------------------------------------------------------
# Alamat API SIMRS sampai /api saja, tanpa garis miring di akhir.
# Kuncinya HARUS sama dengan WEBSITE_SYNC_KEY pada .env SIMRS-API, dan dibuat
# dengan:  openssl rand -hex 32
SIMRS_API_URL=http://127.0.0.1:6969/api
SIMRS_API_KEY=
# Setel false HANYA untuk pengembangan dengan sertifikat swasembada.
SIMRS_API_VERIFY_SSL=true

# ---------------------------------------------------------------------
# Keamanan
# ---------------------------------------------------------------------
# Kunci penandatangan token admin. Buat dengan:  openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=480

# Batas permintaan per menit per alamat IP.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_LOGIN=8

# ---------------------------------------------------------------------
# Unggahan
# ---------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=3145728      # 3 MB
UPLOAD_MIME=image/jpeg,image/png,image/webp
